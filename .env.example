# --- required ---
GEMINI_API_KEY=paste-your-key-here

# --- required when hosted in the cloud (8+ characters; this is the login to your app) ---
APP_PASSCODE=

# --- cloud storage so history survives restarts (free at upstash.com; leave blank to use local files) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- optional ---
# APP_TZ=Asia/Kolkata
# DAILY_GOAL_MIN=45
# STREAK_MIN=10
# GEMINI_MODEL=gemini-3.8-live
# VOICE=Puck
# PORT=3000
